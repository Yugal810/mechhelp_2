{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/aisensy/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/cars/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/garages/:path*",
      "destination": "/api/index.js"
    }
  ]
}
